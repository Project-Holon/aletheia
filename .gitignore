# ROMs and dumps: never commit copyrighted game data
*.nds
*.zip
*.bin
baserom*

# Extracted ROM contents (copyrighted game code/assets)
/extract/

# Disassembly listings (derived from game code, must not be committed)
/asm/

# Build output
/build/

# layout/ IS committed: layout.json and layout.txt hold addresses, sizes and
# names only, never game bytes. The blanket *.bin rule above already keeps
# any binary out of it.
!/layout/

# Downloaded tool binaries (fetched by setup script)
/tools/*.exe
/tools/dsd

# Editor/OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Python bytecode
__pycache__/
