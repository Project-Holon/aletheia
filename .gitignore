# ROMs and dumps: never commit copyrighted game data
*.nds
*.zip
*.bin
baserom*

# Extracted ROM contents (copyrighted game code/assets)
/extract/

# Disassembly listings (derived from game code, must not be committed)
/asm/

# Build output
/build/

# Asset lane output (extracted/converted game assets): never commit game data
/build/assets/

# layout/ IS committed: layout.json and layout.txt hold addresses, sizes and
# names only, never game bytes. The blanket *.bin rule above already keeps
# any binary out of it.
!/layout/

# Proprietary vendor material (compiler, SDKs): never commit any of it
/vendor/
/sdk/
/tools/mwccarm/

# Downloaded tool binaries (fetched by setup script)
/tools/*.exe
/tools/dsd

# Unpacked GNU binutils/gcc for ARM (xpack zip, several hundred MB)
/tools/gcc-arm/

# melonDS emulator (downloaded release zip, used to boot-test rebuilt ROMs)
/tools/melonds/

# Editor/OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Python bytecode
__pycache__/
