# ROMs and dumps: never commit copyrighted game data
*.nds
*.zip
*.bin
baserom*

# DSi key material and BIOS dumps: tools/modcrypt.py reads them at run time
# from a path the user gives; they are never committed (the key constant must
# not appear anywhere in the repo)
*.key
*[Bb][Ii][Oo][Ss]*.bin
*[Bb][Ii][Oo][Ss]*.rom
*[Bb][Ii][Oo][Ss]7*
*[Bb][Ii][Oo][Ss]9*
/NDS_Bios*

# Extracted ROM contents (copyrighted game code/assets)
/extract/

# Disassembly listings (derived from game code, must not be committed)
/asm/

# Build output
/build/

# Generated typed data C (tools/datagen.py, built from the user's own extract): never commit
/build/data/

# Asset lane output (extracted/converted game assets): never commit game data
/build/assets/

# layout/ IS committed: layout.json and layout.txt hold addresses, sizes and
# names only, never game bytes. The blanket *.bin rule above already keeps
# any binary out of it.
!/layout/

# Proprietary vendor material (compiler, SDKs): never commit any of it
/vendor/
/sdk/
/tools/mwccarm/

# Downloaded tool binaries (fetched by setup script)
/tools/*.exe
/tools/dsd

# Unpacked GNU binutils/gcc for ARM (xpack zip, several hundred MB)
/tools/gcc-arm/

# Host toolchain for the port build (xpack MinGW-w64 GCC and portable CMake zips)
/tools/gcc-host/
/tools/cmake/
/tools/ninja/

# melonDS emulator (downloaded release zip, used to boot-test rebuilt ROMs)
/tools/melonds/

# Editor/OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Python bytecode
__pycache__/

# Scratch files (temporary test files used during decompilation)
/scratch/
/scratchpad/

# Junction to the companion port repository (Documents/eidos) so VS Code shows both repos
/eidos/

# game asset formats and build objects (guard rules, 2026-10-12 history audit)
*.bmd0
*.nclr
*.ncgr
*.narc
*.srl
*.sbin
*.rom
*.o
*.a
.claude/
.opencode/

# White ROM extraction (lane WHITE)
/extract_white/
/extract_white_retail/

# Extracts of the other cartridges (tools/targets.py)
/extract_black_*/
/extract_white_*/
